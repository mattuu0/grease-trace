{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScreenAssister",
  "version": "0.2.4",
  "identifier": "com.mattuu0.ScreenAssister",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ScreenAssister",
        "transparent": true,
        "x": 0,
        "y": 0,
        "decorations": false,
        "alwaysOnTop": true,
        "closable": false,
        "maximizable": false,
        "minimizable": false,
        "resizable": false,
        "shadow": false,
        "contentProtected": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": true,
      "certificateThumbprint": null,
      "digestAlgorithm": null,
      "nsis": {
        "languages": ["Japanese"]
      },
      "signCommand": null,
      "timestampUrl": null,
      "tsp": false,
      "webviewInstallMode": {
        "silent": true,
        "type": "downloadBootstrapper"
      },
      "wix": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["whiteboard-app"]
      }
    }
  }
}
