{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "server",
  "version": "0.1.0",
  "identifier": "com.admin.server",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "server",
        "transparent": true,
        "x": 0,
        "y": 0,
        "decorations": false,
        "alwaysOnTop": true,
        "closable": false,
        "maximizable": false,
        "minimizable": false,
        "resizable": false,
        "shadow": false,
        "contentProtected": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["whiteboard-app"]
      }
    }
  }
}